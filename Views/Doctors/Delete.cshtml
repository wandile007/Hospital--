@model Final.Models.Doctor

@{
    ViewBag.Title = "Delete Doctor";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<div class="container mt-5">
    <h2 class="text-danger mb-4">
        <i class="bi bi-trash-fill"></i> Confirm Deletion
    </h2>

    <div class="alert alert-warning" role="alert">
        <strong>Are you sure?</strong> This action will permanently remove the doctor's record.
    </div>

    <div class="card shadow-sm p-4 mb-4 bg-white rounded">
        <h4 class="mb-3">Doctor Details</h4>
        <dl class="row">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Surname)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Surname)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Specialty)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Specialty)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.OfficeLocation)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.OfficeLocation)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.PhoneNumber)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.PhoneNumber)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Email)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.DateJoined)</dt>
            <dd class="col-sm-8">@Model.DateJoined.ToString("yyyy-MM-dd")</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.IsAvailable)</dt>
            <dd class="col-sm-8">
                @if (Model.IsAvailable)
                {
                    <span class="badge bg-success">Available</span>
                }
                else
                {
                    <span class="badge bg-secondary">Unavailable</span>
                }
            </dd>
        </dl>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="d-flex justify-content-between">
            <input type="submit" value="🗑️ Delete" class="btn btn-danger" />
            @Html.ActionLink("← Back to List", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    }
</div>
