@model IEnumerable<Final.Models.Doctor>
@{
    ViewBag.Title = "Doctor Directory";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>



<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">
            <i class="fa-solid fa-user-doctor me-2"></i> Doctor Directory
        </h2>
        @*@Html.ActionLink("Add New Doctor", "Create", null, new { @class = "btn btn-success" })*@
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle shadow-sm">
            <thead class="table-primary text-center">
                <tr>
                    <th><i class="fa fa-id-card me-1"></i>Dr.  @Html.DisplayNameFor(model => model.First().Name)</th>
                    <th><i class="fa fa-user-tag me-1"></i> @Html.DisplayNameFor(model => model.First().Surname)</th>
                    <th><i class="fa fa-stethoscope me-1"></i> @Html.DisplayNameFor(model => model.First().Specialty)</th>
                    <th><i class="fa fa-location-dot me-1"></i> @Html.DisplayNameFor(model => model.First().OfficeLocation)</th>
                    <th><i class="fa fa-phone me-1"></i> @Html.DisplayNameFor(model => model.First().PhoneNumber)</th>
                    <th><i class="fa fa-envelope me-1"></i> @Html.DisplayNameFor(model => model.First().Email)</th>
                    <th><i class="fa fa-calendar-day me-1"></i> @Html.DisplayNameFor(model => model.First().DateJoined)</th>
                    <th><i class="fa fa-circle-check me-1"></i> @Html.DisplayNameFor(model => model.First().IsAvailable)</th>
                    <th><i class="fa fa-gears me-1"></i> Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>Dr. @Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Surname)</td>
                        <td>@Html.DisplayFor(modelItem => item.Specialty)</td>
                        <td>@Html.DisplayFor(modelItem => item.OfficeLocation)</td>
                        <td>@Html.DisplayFor(modelItem => item.PhoneNumber)</td>
                        <td>@Html.DisplayFor(modelItem => item.Email)</td>
                        <td>@item.DateJoined.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (item.IsAvailable)
                            {
                                <span class="badge bg-success"><i class="fa fa-check-circle me-1"></i> Available</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="fa fa-times-circle me-1"></i> Unavailable</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                @Html.ActionLink(" ", "Edit", new { id = item.DoctorId }, new { @class = "btn btn-sm btn-outline-primary", title = "Edit", @data_bs_toggle = "tooltip" })
                                <i class="fa fa-pen-to-square text-primary me-2"></i>

                                @Html.ActionLink(" ", "Details", new { id = item.DoctorId }, new { @class = "btn btn-sm btn-outline-info", title = "Details", @data_bs_toggle = "tooltip" })
                                <i class="fa fa-circle-info text-info me-2"></i>

                                @Html.ActionLink(" ", "Delete", new { id = item.DoctorId }, new { @class = "btn btn-sm btn-outline-danger", title = "Delete", @data_bs_toggle = "tooltip" })
                                <i class="fa fa-trash text-danger"></i>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
