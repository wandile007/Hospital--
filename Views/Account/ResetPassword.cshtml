@model Health__.Models.ResetPasswordViewModel
@{
    ViewBag.Title = "Reset Password";
}

<style>
    main {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 90vh;
        background: linear-gradient(135deg, #e0f7fa, #f1f8e9);
        padding: 20px;
    }

    .reset-card {
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        width: 100%;
        max-width: 500px;
    }

    h2, h4 {
        text-align: center;
        color: #00695c;
    }

    .btn-health {
        background-color: #00796b;
        color: white;
        border: none;
    }

        .btn-health:hover {
            background-color: #004d40;
            color: white;
        }
</style>

<main aria-labelledby="title">
    <div class="reset-card">
        <h2 id="title">@ViewBag.Title</h2>
        <h4>Reset your password</h4>
        <hr />

        @using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.Code)

            <div class="mb-3">
                @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Enter your email", title = "Enter the email linked to your account" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter new password", title = "Password must be at least 6 characters" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm new password", title = "Re-enter your new password" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
            </div>

            <div class="d-grid">
                <input type="submit" class="btn btn-health" value="Reset Password" title="Click to reset your password" />
            </div>
        }
    </div>
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        // Enable Bootstrap tooltips
        document.addEventListener('DOMContentLoaded', function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'))
            tooltipTriggerList.forEach(function (el) {
                new bootstrap.Tooltip(el)
            })
        });
    </script>
}
