@model Final.Models.Patient

@{
    ViewBag.Title = "Register";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

<main class="container py-5">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4><i class="fa-solid fa-user-plus me-2"></i> Patient Registration</h4>
        </div>
        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <div class="row g-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.FullName, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Full Name" })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.DateOfBirth, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.DateOfBirth, new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Gender, new { @class = "form-label" })
                        @Html.EnumDropDownListFor(m => m.Gender, new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", type = "tel", placeholder = "Phone Number" })
                        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "Email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Address, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Address, new { @class = "form-control", placeholder = "Address" })
                        @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.MedicalAidProvider, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.MedicalAidProvider, new { @class = "form-control", placeholder = "Medical Aid Provider" })
                        @Html.ValidationMessageFor(m => m.MedicalAidProvider, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.MedicalAidNumber, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.MedicalAidNumber, new { @class = "form-control", placeholder = "Medical Aid Number" })
                        @Html.ValidationMessageFor(m => m.MedicalAidNumber, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Allergies, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Allergies, new { @class = "form-control", placeholder = "Allergies" })
                        @Html.ValidationMessageFor(m => m.Allergies, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ChronicConditions, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.ChronicConditions, new { @class = "form-control", placeholder = "Chronic Conditions" })
                        @Html.ValidationMessageFor(m => m.ChronicConditions, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.EmergencyContactName, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.EmergencyContactName, new { @class = "form-control", placeholder = "Emergency Contact Name" })
                        @Html.ValidationMessageFor(m => m.EmergencyContactName, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.EmergencyContactPhone, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.EmergencyContactPhone, new { @class = "form-control", type = "tel", placeholder = "Emergency Contact Phone" })
                        @Html.ValidationMessageFor(m => m.EmergencyContactPhone, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label" })
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Create Password" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" })
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm Password" })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-success">
                        <i class="fa-solid fa-user-check me-1"></i> Submit
                    </button>
                    <a href="@Url.Action("Login", "Account")" class="btn btn-outline-secondary ms-2">
                        <i class="fa-solid fa-arrow-left"></i> Back to List
                    </a>
                </div>
            }
        </div>
    </div>
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
