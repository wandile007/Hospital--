@model Health__.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Forgot your password?";
}

<style>
    main {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 90vh;
        background: linear-gradient(135deg, #e0f7fa, #f1f8e9);
        padding: 20px;
    }

    .forgot-card {
        background: white;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
        width: 100%;
        max-width: 500px;
        animation: fadeIn 0.6s ease-in-out;
    }

    h2, h4 {
        text-align: center;
        color: #00695c;
    }

    .icon {
        display: block;
        text-align: center;
        font-size: 3rem;
        color: #00796b;
        margin-bottom: 10px;
    }

    .btn-health {
        background-color: #00796b;
        color: white;
        border: none;
        padding: 10px;
        font-size: 1.1rem;
    }

    .btn-health:hover {
        background-color: #004d40;
        color: white;
    }
</style>

<main aria-labelledby="title">
    <div class="forgot-card">
        <span class="icon">
            <i class="bi bi-envelope-paper-heart"></i> <!-- Bootstrap Icon -->
        </span>
        <h2 id="title">@ViewBag.Title</h2>
        <h4>Enter your email</h4>
        <hr />

        @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-danger" })

            <div class="mb-3">
                @Html.LabelFor(m => m.Email, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Enter your email address", title = "Enter the email linked to your account", @data_bs_toggle = "tooltip" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <div class="d-grid">
                <input type="submit" class="btn btn-health" value="Send Reset Link" title="Click to receive a password reset link" data-bs-toggle="tooltip" />
            </div>

            <br />
            <p class="text-center">
                @Html.ActionLink("Back to Register", "Register", null, new { @title = "Create a new account", @class = "fw-bold" })
            </p>
        }
    </div>
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        // Enable Bootstrap 5 tooltips
        document.addEventListener('DOMContentLoaded', function () {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                new bootstrap.Tooltip(tooltipTriggerEl)
            })
        });
    </script>
}
