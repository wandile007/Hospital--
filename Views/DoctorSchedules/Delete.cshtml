@model Final.Models.DoctorSchedule
@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = "Delete Doctor Schedule";

    var isAdmin = User.IsInRole("Admin");
    var isDoctor = User.IsInRole("Doctor");
    var isPatient = User.IsInRole("Patient");
}

<div class="container mt-5">
    <h2 class="mb-4 text-danger">
        <i class="bi bi-trash3"></i> @(isPatient ? "View Schedule" : "Delete Schedule")
    </h2>

    <div class="alert @(isPatient ? "alert-warning" : "alert-danger")">
        <strong>
            @(isPatient
                ? "You do not have permission to delete this schedule."
                : "Are you sure you want to delete this schedule?")
        </strong>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">Doctor Schedule Details</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Doctor.Name)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Doctor.Name)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.ScheduleDate)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.ScheduleDate)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.StartTime)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.StartTime)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.EndTime)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.EndTime)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.IsAvailable)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.IsAvailable)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.IsRecurring)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.IsRecurring)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.RecurrencePattern)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.RecurrencePattern)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Notes)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Notes)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CreatedOn)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.CreatedOn)</dd>
            </dl>
        </div>
    </div>

    @if (isAdmin || isDoctor)
    {
        using (Html.BeginForm("DeleteConfirmed", "DoctorSchedules", FormMethod.Post, new { @class = "d-inline" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ScheduleId)

            <div class="d-flex justify-content-between">
                <input type="submit" value="Delete" class="btn btn-danger" />
                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-secondary" })
            </div>
        }
    }
    else
    {
        <div class="text-end">
            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    }
</div>
