@model Final.Models.DoctorSchedule
@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = "Edit Doctor Schedule";

    var isAdmin = User.IsInRole("Admin");
    var isDoctor = User.IsInRole("Doctor");
    var isPatient = User.IsInRole("Patient");
}

<div class="container mt-5">
    <h2 class="mb-4 text-primary">
        <i class="bi bi-pencil-square"></i> Edit Doctor Schedule
    </h2>

    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ScheduleId)

        <div class="card shadow-sm p-4 mb-5 bg-white rounded">
            <h4 class="mb-3">Schedule Details</h4>
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <!-- Doctor: only Admin/Doctor -->
            @if (isAdmin || isDoctor)
            {
                <div class="mb-3">
                    @Html.LabelFor(model => model.DoctorId, "Doctor", htmlAttributes: new { @class = "form-label" })
                    @Html.DropDownList("DoctorId", null, htmlAttributes: new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.DoctorId, "", new { @class = "text-danger" })
                </div>
            }
            else
            {
                @Html.HiddenFor(model => model.DoctorId)
            }

            <!-- Schedule Date -->
            <div class="form-floating mb-3">
                @Html.EditorFor(model => model.ScheduleDate, new { htmlAttributes = new { @class = "form-control", type = "date", placeholder = "Schedule Date" } })
                @Html.LabelFor(model => model.ScheduleDate)
                @Html.ValidationMessageFor(model => model.ScheduleDate, "", new { @class = "text-danger" })
            </div>

            <!-- Start Time -->
            <div class="form-floating mb-3">
                @Html.EditorFor(model => model.StartTime, new { htmlAttributes = new { @class = "form-control", type = "time", placeholder = "Start Time" } })
                @Html.LabelFor(model => model.StartTime)
                @Html.ValidationMessageFor(model => model.StartTime, "", new { @class = "text-danger" })
            </div>

            <!-- End Time -->
            <div class="form-floating mb-3">
                @Html.EditorFor(model => model.EndTime, new { htmlAttributes = new { @class = "form-control", type = "time", placeholder = "End Time" } })
                @Html.LabelFor(model => model.EndTime)
                @Html.ValidationMessageFor(model => model.EndTime, "", new { @class = "text-danger" })
            </div>

            <!-- IsAvailable -->
            @if (isAdmin || isDoctor)
            {
                <div class="form-check mb-3">
                    @Html.CheckBoxFor(model => model.IsAvailable, new { @class = "form-check-input", id = "isAvailableCheck" })
                    @Html.LabelFor(model => model.IsAvailable, new { @class = "form-check-label", @for = "isAvailableCheck" })
                    @Html.ValidationMessageFor(model => model.IsAvailable, "", new { @class = "text-danger" })
                </div>
            }
            else
            {
                @Html.HiddenFor(model => model.IsAvailable)
            }

            <!-- IsRecurring -->
            @if (isAdmin || isDoctor)
            {
                <div class="form-check mb-3">
                    @Html.CheckBoxFor(model => model.IsRecurring, new { @class = "form-check-input", id = "isRecurringCheck" })
                    @Html.LabelFor(model => model.IsRecurring, new { @class = "form-check-label", @for = "isRecurringCheck" })
                    @Html.ValidationMessageFor(model => model.IsRecurring, "", new { @class = "text-danger" })
                </div>
            }
            else
            {
                @Html.HiddenFor(model => model.IsRecurring)
            }

            <!-- Recurrence Pattern -->
            @if (isAdmin || isDoctor)
            {
                <div class="form-floating mb-3">
                    @Html.EditorFor(model => model.RecurrencePattern, new { htmlAttributes = new { @class = "form-control", placeholder = "Recurrence Pattern" } })
                    @Html.LabelFor(model => model.RecurrencePattern)
                    @Html.ValidationMessageFor(model => model.RecurrencePattern, "", new { @class = "text-danger" })
                </div>
            }
            else
            {
                @Html.HiddenFor(model => model.RecurrencePattern)
            }

            <!-- Notes -->
            <div class="form-floating mb-3">
                @Html.TextAreaFor(model => model.Notes, new { @class = "form-control", placeholder = "Notes", rows = 3 })
                @Html.LabelFor(model => model.Notes)
                @Html.ValidationMessageFor(model => model.Notes, "", new { @class = "text-danger" })
            </div>

            <!-- CreatedOn -->
            @if (isAdmin || isDoctor)
            {
                <div class="form-floating mb-3">
                    @Html.EditorFor(model => model.CreatedOn, new { htmlAttributes = new { @class = "form-control", type = "datetime-local", placeholder = "Created On" } })
                    @Html.LabelFor(model => model.CreatedOn)
                    @Html.ValidationMessageFor(model => model.CreatedOn, "", new { @class = "text-danger" })
                </div>
            }
            else
            {
                @Html.HiddenFor(model => model.CreatedOn)
            }

            <!-- Submit -->
            <div class="d-flex justify-content-between mt-4">
                <input type="submit" value="Save" class="btn btn-primary" />
                @Html.ActionLink("← Back to List", "Index", null, new { @class = "btn btn-outline-secondary" })
            </div>
        </div>
    }
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
