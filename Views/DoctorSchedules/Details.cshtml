@model Final.Models.DoctorSchedule
@using Microsoft.AspNet.Identity

@{
    ViewBag.Title = "Schedule Details";
    var isAdmin = User.IsInRole("Admin");
    var isDoctor = User.IsInRole("Doctor");
    var isPatient = User.IsInRole("Patient");
}

<div class="container mt-5">
    <h2 class="mb-4 text-primary">
        <i class="bi bi-calendar-check"></i> Schedule Details
    </h2>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">Doctor Schedule</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Doctor.Name)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Doctor.Name)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.ScheduleDate)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.ScheduleDate)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.StartTime)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.StartTime)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.EndTime)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.EndTime)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.IsAvailable)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.IsAvailable)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.IsRecurring)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.IsRecurring)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.RecurrencePattern)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.RecurrencePattern)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Notes)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.Notes)</dd>

                <dt class="col-sm-4">@Html.DisplayNameFor(m => m.CreatedOn)</dt>
                <dd class="col-sm-8">@Html.DisplayFor(m => m.CreatedOn)</dd>
            </dl>
        </div>
    </div>

    <div class="d-flex justify-content-between">
        @if (isAdmin || isDoctor)
        {
            <div>
                @Html.ActionLink("Edit", "Edit", new { id = Model.ScheduleId }, new { @class = "btn btn-outline-primary me-2" })
                @Html.ActionLink("Delete", "Delete", new { id = Model.ScheduleId }, new { @class = "btn btn-outline-danger" })
            </div>
        }
        <div>
            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-secondary" })
        </div>
    </div>
</div>
