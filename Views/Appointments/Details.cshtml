@model Final.Models.Appointment

@{
    ViewBag.Title = "Appointment Details";
}

<!-- Bootstrap & Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h4><i class="fa-solid fa-file-medical me-2"></i> Appointment Details</h4>
            <a href="@Url.Action("Index")" class="btn btn-light btn-sm">
                <i class="fa-solid fa-arrow-left"></i> Back to List
            </a>
        </div>

        <div class="card-body">
            <dl class="row">
                @*<dt class="col-sm-3 fw-bold">
                    <i class="fa-solid fa-user-patient me-1"></i> Patient
                </dt>
                <dd class="col-sm-9">
                     @Html.DisplayFor(model => model.Patient.FullName)
                </dd>*@

                <dt class="col-sm-3 fw-bold">
                    <i class="fa-solid fa-user-doctor me-1"></i> Doctor
                </dt>
                <dd class="col-sm-9">
                    Dr. @Html.DisplayFor(model => model.Doctor.Surname)
                </dd>

                <dt class="col-sm-3 fw-bold">
                    <i class="fa-solid fa-stethoscope me-1"></i> Specialty
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Doctor.Specialty)
                </dd>

                <dt class="col-sm-3 fw-bold">
                    <i class="fa-solid fa-calendar-day me-1"></i> Appointment Date
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.AppointmentDate)
                </dd>

                <dt class="col-sm-3 fw-bold">
                    <i class="fa-solid fa-clipboard-check me-1"></i> Status
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Status)
                </dd>

                <dt class="col-sm-3 fw-bold">
                    <i class="fa-solid fa-clock me-1"></i> Created On
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.CreatedOn)
                </dd>

                <dt class="col-sm-3 fw-bold">
                    <i class="fa-solid fa-calendar-check me-1"></i> Booking Date
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.BookingDate)
                </dd>
            </dl>


            <div class="mt-4 d-flex justify-content-start gap-3">
                <button class="btn btn-outline-primary" onclick="window.print()">
                    <i class="fa-solid fa-print me-1"></i> Print
                </button>
                <button class="btn btn-outline-danger" onclick="exportPDF()">
                    <i class="fa-solid fa-file-pdf me-1"></i> Export to PDF
                </button>

                <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning">
                    <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                </a>
                <a href="@Url.Action("Index")" class="btn btn-secondary">
                    <i class="fa-solid fa-list me-1"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>
<button class="btn btn-outline-danger" onclick="exportPDF()">
    <i class="fa-solid fa-file-pdf me-1"></i> Export to PDF
</button>

<script>
    function exportPDF() {
        const element = document.querySelector('.card'); // or any container you want to export
        html2pdf().set({
            margin: 0.5,
            filename: 'AppointmentDetails.pdf',
            image: { type: 'jpeg', quality: 0.98 },
            html2canvas: { scale: 2 },
            jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
        }).from(element).save();
    }
</script>

