@model Final.Models.MedicalRecord

@{
    ViewBag.Title = "Edit Medical Record";
}

<div class="container mt-5">
    <h2 class="mb-4 text-primary">
        <i class="bi bi-pencil-square"></i> Edit Medical Record
    </h2>

    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "needs-validation", novalidate = "novalidate" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.RecordId)

        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">Update Record</h5>
            </div>
            <div class="card-body">
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <div class="mb-3">
                    @Html.LabelFor(model => model.PatientId, "Patient", htmlAttributes: new { @class = "form-label" })
                    @Html.DropDownList("PatientId", null, htmlAttributes: new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.PatientId, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.DoctorId, "Doctor", htmlAttributes: new { @class = "form-label" })
                    @Html.DropDownList("DoctorId", null, htmlAttributes: new { @class = "form-select" })
                    @Html.ValidationMessageFor(model => model.DoctorId, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Diagnosis, htmlAttributes: new { @class = "form-label" })
                    @Html.EditorFor(model => model.Diagnosis, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.Diagnosis, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.TreatmentPlan, htmlAttributes: new { @class = "form-label" })
                    @Html.EditorFor(model => model.TreatmentPlan, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.TreatmentPlan, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.PrescribedMedications, htmlAttributes: new { @class = "form-label" })
                    @Html.EditorFor(model => model.PrescribedMedications, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.PrescribedMedications, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.LabTestsOrdered, htmlAttributes: new { @class = "form-label" })
                    @Html.EditorFor(model => model.LabTestsOrdered, new { htmlAttributes = new { @class = "form-control" } })
                    @Html.ValidationMessageFor(model => model.LabTestsOrdered, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.VisitDate, htmlAttributes: new { @class = "form-label" })
                    @Html.EditorFor(model => model.VisitDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                    @Html.ValidationMessageFor(model => model.VisitDate, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.CreatedDate, htmlAttributes: new { @class = "form-label" })
                    @Html.EditorFor(model => model.CreatedDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                    @Html.ValidationMessageFor(model => model.CreatedDate, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.Notes, htmlAttributes: new { @class = "form-label" })
                    @Html.TextAreaFor(model => model.Notes, new { @class = "form-control", rows = 3 })
                    @Html.ValidationMessageFor(model => model.Notes, "", new { @class = "text-danger" })
                </div>

                <div class="form-check mb-3">
                    @Html.CheckBoxFor(model => model.IsFollowUpRequired, new { @class = "form-check-input" })
                    @Html.LabelFor(model => model.IsFollowUpRequired, htmlAttributes: new { @class = "form-check-label" })
                    @Html.ValidationMessageFor(model => model.IsFollowUpRequired, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(model => model.FollowUpDate, htmlAttributes: new { @class = "form-label" })
                    @Html.EditorFor(model => model.FollowUpDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                    @Html.ValidationMessageFor(model => model.FollowUpDate, "", new { @class = "text-danger" })
                </div>

                <button type="submit" class="btn btn-success">
                    <i class="bi bi-save"></i> Save Changes
                </button>
            </div>
        </div>
    }

    <div class="mt-3">
        @Html.ActionLink("← Back to List", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
